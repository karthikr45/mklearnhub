generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organizations ───────────────────────────────────

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  type       OrgType  @default(BUSINESS)
  logoUrl    String?
  domain     String?  @unique
  plan       Plan     @default(FREE)
  isActive   Boolean  @default(true)
  settings   Json     @default("{}")
  maxUsers   Int      @default(5)
  maxCourses Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // School directory (used when type = SCHOOL). Lets students find and
  // self-register into a real, listed institution.
  board             EducationBoard?
  state             IndianState?
  city              String?
  listedInDirectory Boolean         @default(false)

  users         User[]
  portals       Portal[]
  spaces        Space[]
  courses       Course[]
  batches       Batch[]
  branches      Branch[]
  subscriptions Subscription[]
  invites       Invite[]

  ssoConfiguration    SsoConfiguration?
  hrmsSyncs           HrmsSync[]
  scormPackages       ScormPackage[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  brandingConfig      BrandingConfig?
  dedicatedInstance   DedicatedInstance?
  bulkImportJobs      BulkImportJob[]
  studyGroups         StudyGroup[]
  subjects            Subject[]
  assessments         Assessment[]
  assessmentQuestions AssessmentQuestion[]

  @@index([slug])
  @@index([type, state, board])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  batches      Batch[]

  @@index([organizationId])
  @@map("branches")
}

// ─── Users & Auth ────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String
  avatarUrl      String?
  role           UserRole  @default(LEARNER)
  organizationId String?
  branchId       String?
  isActive       Boolean   @default(true)
  emailVerified  Boolean   @default(false)
  onboarded      Boolean   @default(false)
  timezone       String    @default("UTC")
  locale         String    @default("en")
  // Consent records (DPDP Act 2023): when the user accepted Terms & Privacy,
  // and — for student self-registration — when parental/guardian consent was
  // affirmed.
  termsAcceptedAt   DateTime?
  parentalConsentAt DateTime?
  // A student's shareable code that lets a parent self-register already
  // linked to this child (no browsing a list of minors).
  parentLinkCode String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  organization    Organization?          @relation(fields: [organizationId], references: [id])
  branch          Branch?                @relation(fields: [branchId], references: [id])
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  articles        Article[]              @relation("ArticleAuthor")
  articleVersions ArticleVersion[]
  enrollments     Enrollment[]
  quizAttempts    QuizAttempt[]
  assignments     AssignmentSubmission[]
  certificates    Certificate[]
  parentLinks     ParentStudentLink[]    @relation("ParentLink")
  studentLinks    ParentStudentLink[]    @relation("StudentLink")
  attendance      AttendanceRecord[]
  grades          Grade[]
  notifications   Notification[]
  createdCourses  Course[]               @relation("CourseInstructor")
  invitesSent     Invite[]
  batchStudents   BatchStudent[]
  lessonProgress  LessonProgress[]
  scormTracking   ScormTracking[]

  studyGroupsCreated    StudyGroup[]         @relation("GroupCreator")
  studyGroupMemberships StudyGroupMember[]
  studyGroupMessages    StudyGroupMessage[]
  studyGroupResources   StudyGroupResource[]
  moderationEvents      ModerationEvent[]
  assessmentAttempts    AssessmentAttempt[]
  hostedBattles         QuizBattle[]         @relation("BattleHost")
  battleParticipations  BattleParticipant[]
  doubts                Doubt[]              @relation("DoubtAuthor")
  doubtAnswers          DoubtAnswer[]        @relation("AnswerAuthor")
  doubtVotes            DoubtVote[]
  pushSubscriptions     PushSubscription[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

/// A browser Web Push subscription (one per device/browser). Used to deliver
/// notifications when the user is offline. Web Push is optional — without VAPID
/// keys the app simply never sends, and these rows sit unused.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model OAuthAccount {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model Invite {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  role           UserRole
  invitedById    String
  token          String    @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([token])
  @@map("invites")
}

// ─── Knowledge Base ───────────────────────────────────

model Portal {
  id             String     @id @default(cuid())
  name           String
  slug           String
  organizationId String
  type           PortalType @default(INTERNAL)
  logoUrl        String?
  primaryColor   String?
  customDomain   String?    @unique
  isPublic       Boolean    @default(false)
  isActive       Boolean    @default(true)
  settings       Json       @default("{}")
  pageJson       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  spaces       Space[]

  @@unique([organizationId, slug])
  @@map("portals")
}

model Space {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?
  organizationId String
  portalId       String?
  iconEmoji      String?
  coverUrl       String?
  isPublic       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  portal       Portal?      @relation(fields: [portalId], references: [id])
  manuals      Manual[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("spaces")
}

model Manual {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  spaceId     String
  order       Int      @default(0)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([spaceId, slug])
  @@index([spaceId])
  @@map("manuals")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String
  content     Json
  excerpt     String?
  manualId    String
  authorId    String
  status      ArticleStatus @default(DRAFT)
  isPublic    Boolean       @default(false)
  tags        String[]
  views       Int           @default(0)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  manual   Manual           @relation(fields: [manualId], references: [id], onDelete: Cascade)
  author   User             @relation("ArticleAuthor", fields: [authorId], references: [id])
  versions ArticleVersion[]

  @@unique([manualId, slug])
  @@index([manualId])
  @@index([authorId])
  @@map("articles")
}

model ArticleVersion {
  id         String   @id @default(cuid())
  articleId  String
  content    Json
  version    Int
  editedById String
  createdAt  DateTime @default(now())

  article  Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editedBy User    @relation(fields: [editedById], references: [id])

  @@index([articleId])
  @@map("article_versions")
}

// ─── Courses & LMS ───────────────────────────────────

model Course {
  id              String       @id @default(cuid())
  title           String
  slug            String
  description     String?
  thumbnailUrl    String?
  organizationId  String
  instructorId    String
  status          CourseStatus @default(DRAFT)
  isPublic        Boolean      @default(false)
  isFree          Boolean      @default(true)
  price           Decimal?     @db.Decimal(10, 2)
  currency        String       @default("USD")
  tags            String[]
  level           CourseLevel  @default(BEGINNER)
  language        String       @default("en")
  durationMins    Int          @default(0)
  totalLessons    Int          @default(0)
  enrollmentCount Int          @default(0)
  rating          Decimal?     @db.Decimal(3, 2)
  ratingCount     Int          @default(0)
  settings        Json         @default("{}")
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  chapters     Chapter[]
  enrollments  Enrollment[]
  certificates Certificate[]
  batchCourses BatchCourse[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([instructorId])
  @@map("courses")
}

model Chapter {
  id          String   @id @default(cuid())
  title       String
  description String?
  courseId    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("chapters")
}

model Lesson {
  id                String     @id @default(cuid())
  title             String
  description       String?
  chapterId         String
  type              LessonType @default(VIDEO)
  content           Json?
  videoUrl          String?
  videoKey          String?
  videoDurationSecs Int?
  hlsUrl            String?
  transcriptUrl     String?
  order             Int        @default(0)
  isFreePreview     Boolean    @default(false)
  isPublished       Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  quiz        Quiz?
  lessonScorm LessonScorm?

  @@index([chapterId])
  @@map("lessons")
}

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  courseId     String
  status       EnrollmentStatus @default(ENROLLED)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
  expiresAt    DateTime?
  progressPct  Int              @default(0)
  lastAccessAt DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  certificate Certificate?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  userId       String
  isCompleted  Boolean   @default(false)
  watchedSecs  Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  enrollmentId  String   @unique
  certificateNo String   @unique
  issuedAt      DateTime @default(now())
  pdfUrl        String?
  verifyToken   String   @unique @default(cuid())

  user       User       @relation(fields: [userId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([userId])
  @@map("certificates")
}

// ─── Assessments ─────────────────────────────────────

model Quiz {
  id               String   @id @default(cuid())
  title            String
  lessonId         String?  @unique
  organizationId   String
  passingScore     Int      @default(70)
  timeLimitMins    Int?
  maxAttempts      Int      @default(3)
  shuffleQuestions Boolean  @default(false)
  showAnswers      Boolean  @default(true)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]

  @@index([organizationId])
  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType @default(MCQ)
  text          String
  explanation   String?
  points        Int          @default(1)
  order         Int          @default(0)
  options       Json?
  correctAnswer String?
  createdAt     DateTime     @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id            String    @id @default(cuid())
  quizId        String
  userId        String
  answers       Json
  score         Int
  maxScore      Int
  passed        Boolean
  timeTakenSecs Int?
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model Assignment {
  id             String    @id @default(cuid())
  title          String
  description    String
  organizationId String
  dueDate        DateTime?
  maxScore       Int       @default(100)
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submissions AssignmentSubmission[]

  @@index([organizationId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String?
  attachments  Json             @default("[]")
  score        Int?
  feedback     String?
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
  @@index([userId])
  @@map("assignment_submissions")
}

// ─── School Module ───────────────────────────────────

model Batch {
  id             String          @id @default(cuid())
  name           String
  organizationId String
  branchId       String?
  academicYearId String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean         @default(true)
  maxStudents    Int?
  // Class / section metadata + self-registration join code (Google
  // Classroom style). A student who enters `joinCode` is bound to exactly
  // this school + academic year + class.
  grade          String?
  section        String?
  board          EducationBoard?
  joinCode       String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  academicYear AcademicYear?      @relation(fields: [academicYearId], references: [id])
  students     BatchStudent[]
  timetable    TimetableSlot[]
  batchCourses BatchCourse[]
  attendance   AttendanceRecord[]
  examTracks   BatchExamTrack[]

  @@index([organizationId])
  @@map("batches")
}

model BatchStudent {
  id       String   @id @default(cuid())
  batchId  String
  userId   String
  joinedAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([batchId, userId])
  @@map("batch_students")
}

model BatchCourse {
  id       String @id @default(cuid())
  batchId  String
  courseId String

  batch  Batch  @relation(fields: [batchId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([batchId, courseId])
  @@map("batch_courses")
}

model AcademicYear {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  batches     Batch[]
  grades      Grade[]
  studyGroups StudyGroup[]

  @@index([organizationId])
  @@map("academic_years")
}

model TimetableSlot {
  id           String   @id @default(cuid())
  batchId      String
  dayOfWeek    Int
  startTime    String
  endTime      String
  subject      String
  instructorId String?
  room         String?
  createdAt    DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@map("timetable_slots")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  batchId    String
  userId     String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String?
  createdAt  DateTime         @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([batchId, userId, date])
  @@index([batchId])
  @@index([userId])
  @@map("attendance_records")
}

model Grade {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  academicYearId String?
  subject        String
  score          Decimal  @db.Decimal(5, 2)
  maxScore       Decimal  @db.Decimal(5, 2)
  gradeLabel     String?
  term           String?
  remarks        String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([userId])
  @@map("grades")
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String   @default("parent")
  createdAt DateTime @default(now())

  parent  User @relation("ParentLink", fields: [parentId], references: [id])
  student User @relation("StudentLink", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@map("parent_student_links")
}

// ─── Notifications ───────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json      @default("{}")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Billing ─────────────────────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  plan               Plan
  status             SubscriptionStatus @default(ACTIVE)
  stripeCustomerId   String?
  stripeSubId        String?            @unique
  razorpayCustomerId String?
  razorpaySubId      String?            @unique
  provider           String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("subscriptions")
}

// ─── Curriculum spine + assessment engine ────────────
//
// The reusable backbone for student study: every subject/chapter/topic and
// every question hangs off this tree. `organizationId` may be null for
// platform-global curriculum (e.g. a shared JEE Physics syllabus that any
// school can use); a non-null value scopes it to one school.

model Subject {
  id             String         @id @default(cuid())
  name           String
  code           String?
  organizationId String?
  grade          String?
  stream         String?
  examTrack      ExamTrackType?
  color          String?
  order          Int            @default(0)
  createdAt      DateTime       @default(now())

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chapters     SyllabusChapter[]
  questions    AssessmentQuestion[]
  assessments  Assessment[]

  @@index([organizationId])
  @@index([examTrack])
  @@map("subjects")
}

model SyllabusChapter {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics      Topic[]
  questions   AssessmentQuestion[]
  assessments Assessment[]

  @@index([subjectId])
  @@map("syllabus_chapters")
}

model Topic {
  id        String   @id @default(cuid())
  chapterId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  chapter   SyllabusChapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]

  @@index([chapterId])
  @@map("topics")
}

// Reusable question bank. `options`/`correctAnswer` are JSON so one model
// covers MCQ, multi-select, numeric and assertion-reason questions.
model AssessmentQuestion {
  id             String                 @id @default(cuid())
  organizationId String?
  subjectId      String
  chapterId      String?
  topicId        String?
  examTrack      ExamTrackType?
  type           AssessmentQuestionType @default(MCQ)
  difficulty     Difficulty             @default(MEDIUM)
  text           String
  options        Json                   @default("[]")
  correctAnswer  Json
  explanation    String?
  marks          Int                    @default(1)
  negativeMarks  Float                  @default(0)
  createdById    String?
  createdAt      DateTime               @default(now())

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter      SyllabusChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic        Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  items        AssessmentItem[]
  responses    AttemptResponse[]

  @@index([subjectId])
  @@index([topicId])
  @@index([examTrack, difficulty])
  @@map("assessment_questions")
}

// A fixed assessment: chapter test, full mock, or previous-year paper.
// (Free-form practice does not need one — it selects questions dynamically.)
model Assessment {
  id              String         @id @default(cuid())
  title           String
  type            AssessmentType @default(CHAPTER_TEST)
  organizationId  String?
  subjectId       String?
  chapterId       String?
  examTrack       ExamTrackType?
  durationMins    Int?
  negativeMarking Boolean        @default(false)
  isPublished     Boolean        @default(true)
  createdById     String?
  createdAt       DateTime       @default(now())

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapter      SyllabusChapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  items        AssessmentItem[]
  attempts     AssessmentAttempt[]

  @@index([organizationId])
  @@index([examTrack])
  @@map("assessments")
}

model AssessmentItem {
  id           String @id @default(cuid())
  assessmentId String
  questionId   String
  order        Int    @default(0)

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_items")
}

// One student sitting: either a fixed Assessment or a dynamic practice set
// (assessmentId null → subject/chapter/topic describe what was practised).
model AssessmentAttempt {
  id           String         @id @default(cuid())
  userId       String
  assessmentId String?
  mode         AttemptMode    @default(PRACTICE)
  status       AttemptStatus  @default(IN_PROGRESS)
  subjectId    String?
  chapterId    String?
  topicId      String?
  examTrack    ExamTrackType?
  score        Float          @default(0)
  maxScore     Float          @default(0)
  correctCount Int            @default(0)
  totalCount   Int            @default(0)
  durationSecs Int?
  analytics    Json           @default("{}")
  startedAt    DateTime       @default(now())
  submittedAt  DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  responses  AttemptResponse[]

  @@index([userId, submittedAt])
  @@map("assessment_attempts")
}

model AttemptResponse {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  response      Json?
  isCorrect     Boolean  @default(false)
  marksAwarded  Float    @default(0)
  timeSpentSecs Int?
  createdAt     DateTime @default(now())

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_responses")
}

// Which competitive/board exams a class is preparing for.
model BatchExamTrack {
  id        String        @id @default(cuid())
  batchId   String
  examTrack ExamTrackType
  createdAt DateTime      @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, examTrack])
  @@map("batch_exam_tracks")
}

// ─── Doubts & Q&A (topic-tagged, moderated) ──────────

model Doubt {
  id             String   @id @default(cuid())
  organizationId String?
  authorId       String
  subjectId      String?
  topicId        String?
  title          String
  body           String
  isResolved     Boolean  @default(false)
  upvotes        Int      @default(0)
  answerCount    Int      @default(0)
  createdAt      DateTime @default(now())

  author  User          @relation("DoubtAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answers DoubtAnswer[]

  @@index([organizationId, subjectId])
  @@index([topicId])
  @@map("doubts")
}

model DoubtAnswer {
  id         String   @id @default(cuid())
  doubtId    String
  authorId   String
  body       String
  isAccepted Boolean  @default(false)
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())

  doubt  Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author User  @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([doubtId])
  @@map("doubt_answers")
}

// One row per upvote; nullable target columns keep one table for both doubts
// and answers (Postgres treats NULLs as distinct, so the uniques hold).
model DoubtVote {
  id        String   @id @default(cuid())
  userId    String
  doubtId   String?
  answerId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, doubtId])
  @@unique([userId, answerId])
  @@map("doubt_votes")
}

// ─── Live quiz battles (real-time, in a study group) ─

model QuizBattle {
  id          String       @id @default(cuid())
  groupId     String
  hostId      String
  title       String
  questionIds Json         @default("[]")
  status      BattleStatus @default(LOBBY)
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?

  group        StudyGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  host         User                @relation("BattleHost", fields: [hostId], references: [id])
  participants BattleParticipant[]

  @@index([groupId])
  @@map("quiz_battles")
}

model BattleParticipant {
  id           String   @id @default(cuid())
  battleId     String
  userId       String
  score        Int      @default(0)
  correctCount Int      @default(0)
  joinedAt     DateTime @default(now())

  battle QuizBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@map("battle_participants")
}

// ─── Student study groups (peer-scoped, moderated) ───

// A student-created study group, strictly scoped to one school
// (organization) + one academic year. Only STUDENTs of that same school and
// year may join, so children only ever share space with verified classmates.
model StudyGroup {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  academicYearId String
  gradeLabel     String?
  createdById    String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("GroupCreator", fields: [createdById], references: [id])
  members      StudyGroupMember[]
  messages     StudyGroupMessage[]
  resources    StudyGroupResource[]
  battles      QuizBattle[]

  @@index([organizationId, academicYearId])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String         @id @default(cuid())
  groupId  String
  userId   String
  role     StudyGroupRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("study_group_members")
}

model StudyGroupMessage {
  id               String           @id @default(cuid())
  groupId          String
  userId           String
  body             String
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("study_group_messages")
}

model StudyGroupResource {
  id               String            @id @default(cuid())
  groupId          String
  userId           String
  type             GroupResourceType
  title            String
  body             String?
  url              String?
  fileKey          String?
  moderationStatus ModerationStatus  @default(APPROVED)
  createdAt        DateTime          @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("study_group_resources")
}

// Audit trail of every child-safety decision. School staff review this.
model ModerationEvent {
  id             String               @id @default(cuid())
  organizationId String?
  userId         String
  targetType     ModerationTargetType
  status         ModerationStatus
  reasons        String[]
  matched        String[]
  excerpt        String?
  createdAt      DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("moderation_events")
}

