# ─── Core ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://learnhub:learnhub_dev@localhost:5432/learnhub_db"

# ─── Auth / JWT ──────────────────────────────────────
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Infrastructure (optional locally) ───────────────
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=

# ─── Object storage (provider-agnostic; disabled when blank) ──
# One S3-compatible adapter covers AWS S3, Cloudflare R2, Backblaze B2, Wasabi,
# DigitalOcean Spaces and MinIO — only the config below differs. Pick a provider
# by cost later without any code change.
#   STORAGE_PROVIDER: s3 | r2 | b2 | wasabi | spaces | minio  (all use the S3 adapter)
#   STORAGE_ENDPOINT: leave blank for AWS S3; set for the others, e.g.
#     R2     -> https://<accountid>.r2.cloudflarestorage.com   (STORAGE_REGION=auto)
#     B2     -> https://s3.<region>.backblazeb2.com
#     Wasabi -> https://s3.<region>.wasabisys.com
#     Spaces -> https://<region>.digitaloceanspaces.com
#     MinIO  -> http://localhost:9000   (STORAGE_FORCE_PATH_STYLE=true)
#   STORAGE_PUBLIC_BASE_URL: CDN/public base for immutable public assets (optional)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false

# Legacy AWS_* names are still read as a fallback for existing deployments.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ─── AI (optional) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Stripe (optional; billing disabled when blank) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Razorpay (optional) ─────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Email (optional) ────────────────────────────────
RESEND_API_KEY=

# ─── Web Push / VAPID (optional) ─────────────────────
# Generate with: npx web-push generate-vapid-keys
# Without these, push notifications are simply never sent (in-app still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@learnhub.com

# ─── LiveKit live study rooms (optional) ─────────────
# Without these, live audio/video rooms show a "not enabled" state.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Google OAuth (optional) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── URLs ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3001

# ─── Feature flags ───────────────────────────────────
ENABLE_QUEUES=false
ENABLE_SEARCH=false

# SSO
SAML_SP_ENTITY_ID=https://app.learnhub.com/sso/metadata
SAML_SP_BASE_URL=https://app.learnhub.com
# Encryption
ENCRYPTION_KEY=            # 32-byte hex (openssl rand -hex 32)
WEBHOOK_SIGNING_KEY=
# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
# Neon
NEON_API_KEY=
# SCORM
SCORM_CDN_URL=https://cdn.learnhub.com
