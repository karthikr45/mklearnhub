# ---------------------------------------------------------------------------
# LearnHub on-premise stack — configuration.
# Copy to `.env` and edit. `docker compose -f docker-compose.instance.yml` reads
# this file for both service env_file injection and ${VAR} interpolation.
# ---------------------------------------------------------------------------

# ─── Image tag (built or pulled) ─────────────────────
IMAGE_TAG=latest

# ─── Postgres ────────────────────────────────────────
POSTGRES_USER=learnhub
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=learnhub_db
# Consumed by the api container. Host is the compose service name `postgres`.
DATABASE_URL=postgresql://learnhub:change-me-strong-db-password@postgres:5432/learnhub_db

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Elasticsearch ───────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── Auth / JWT ──────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption / webhooks ───────────────────────────
# 32-byte hex — generate with: openssl rand -hex 32
ENCRYPTION_KEY=
WEBHOOK_SIGNING_KEY=change-me-webhook-signing-key

# ─── Object storage (MinIO, S3-compatible) ───────────
MINIO_ROOT_USER=learnhub
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
S3_BUCKET=learnhub-media
AWS_REGION=us-east-1
# The api container reaches MinIO at the internal endpoint (set in compose):
#   S3_ENDPOINT=http://minio:9000  S3_FORCE_PATH_STYLE=true

# ─── URLs ────────────────────────────────────────────
# Public base URL the browser uses to reach the API (through your reverse proxy).
PUBLIC_API_URL=http://localhost:3001/api/v1
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3001

# ─── Feature flags ───────────────────────────────────
ENABLE_QUEUES=true
ENABLE_SEARCH=true

# ─── Optional third-party integrations (leave blank to disable) ──
ANTHROPIC_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
