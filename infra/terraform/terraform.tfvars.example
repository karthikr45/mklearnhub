# Copy to terraform.tfvars and edit. Do NOT commit real secrets — prefer
# TF_VAR_db_password via your secret manager / CI over storing it here.

region  = "ap-south-1"
env     = "prod"
project = "learnhub"

vpc_cidr = "10.0.0.0/16"
domain   = "app.learnhub.com"

# ── RDS ──
db_instance_class    = "db.r6g.large"
db_allocated_storage = 100
db_username          = "learnhub"
db_password          = "REPLACE_ME_WITH_A_STRONG_PASSWORD"

# ── ElastiCache ──
redis_node_type = "cache.r6g.large"

# ── ECS ──
api_image         = "ghcr.io/learnhub/api:1.0.0"
api_desired_count = 3

# ── TLS (ACM cert must live in us-east-1 for CloudFront) ──
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
